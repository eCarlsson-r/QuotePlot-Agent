# Bright Data Configuration
# Get your API keys from: https://brightdata.com/cp/start

# Bright Data API Key (for SERP API, Web Unlocker, Scrapers)
BRIGHTDATA_API_KEY=your_api_key_here
BRIGHTDATA_CUSTOMER_ID=your_customer_id_here

# Bright Data SERP API Zone Name
# Create a SERP API zone at: https://brightdata.com/cp/learn_more/serp-api
BRIGHTDATA_SERP_ZONE=your_serp_zone_name_here

# Bright Data Web Unlocker Zone Name
# Create a Web Unlocker zone at: https://brightdata.com/cp/learn_more/web-unlocker
BRIGHTDATA_UNLOCKER_ZONE=your_unlocker_zone_name_here

# Bright Data Browser Scraping Zone Name
BRIGHTDATA_BROWSER_ZONE=your_serp_zone_name_here

# Google Gemini API Key (for Lucy Agent)
GEMINI_API_KEY=your_gemini_api_key_here
ETH_RPC_URL=your_ethereum_rpc_endpoint

# Optional Hermes API key for Pyth price-feed requests.
# Required when Hermes returns HTTP 401 for this deployment.
# PYTH_HERMES_API_KEY=your_pyth_hermes_api_key_here

# Angular frontend origin used by FastAPI CORS (local development default)
FRONTEND_URL=http://localhost:4200

# Database Configuration (MySQL recommended for production)
# Option A — single URL (password with special chars will be URL-encoded by the app if built from parts)
# DB_URL=mysql+pymysql://root:password@localhost:3306/quoteplot
# Option B — components (used when DB_URL is unset)
DB_USER=root
DB_PASS=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quoteplot

# Server Configuration
PORT=8000

# Optional Hardhat Sepolia deployment settings (keep values in your local environment)
# SEPOLIA_RPC_URL=https://your-sepolia-rpc-endpoint
# SEPOLIA_PRIVATE_KEY=0x...
